{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandResultBase",
  "type": "object",
  "required": [
    "command_id",
    "edge_id",
    "command_type",
    "status",
    "executed_at"
  ],
  "properties": {
    "command_id": {
      "type": "string"
    },
    "edge_id": {
      "type": "string"
    },
    "command_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "dispatched",
        "acked",
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "dead_lettered"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
