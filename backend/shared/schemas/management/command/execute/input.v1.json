{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManagementSendCommand",
  "type": "object",
  "required": [
    "management_command_id",
    "edge_id",
    "command_type",
    "payload",
    "issued_by"
  ],
  "properties": {
    "management_command_id": {
      "type": "string",
      "description": "Internal management command ID"
    },
    "edge_id": {
      "type": "string"
    },
    "command_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "issued_by": {
      "type": "string",
      "description": "USER | AI | RULE"
    },
    "policy_context": {
      "type": "object",
      "description": "Optional rule / AI context"
    }
  },
  "additionalProperties": false
}
