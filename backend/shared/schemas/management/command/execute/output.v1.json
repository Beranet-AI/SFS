{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManagementReceiveCommandResult",
  "type": "object",
  "required": [
    "management_command_id",
    "edge_id",
    "command_type",
    "status",
    "received_at"
  ],
  "properties": {
    "management_command_id": {
      "type": "string"
    },
    "edge_id": {
      "type": "string"
    },
    "command_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED"]
    },
    "result_payload": {
      "type": "object",
      "description": "Edge execution result"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
