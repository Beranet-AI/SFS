{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandBase",
  "type": "object",
  "required": [
    "command_id",
    "command_type",
    "edge_id",
    "issued_at"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "description": "Unique command identifier (UUID recommended)"
    },
    "command_type": {
      "type": "string",
      "description": "Command discriminator"
    },
    "edge_id": {
      "type": "string",
      "description": "Target edge identifier"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
