{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryInput",
  "type": "object",
  "required": [
    "edge_id",
    "device_id",
    "device_type",
    "timestamp",
    "metrics"
  ],
  "properties": {
    "edge_id": { "type": "string" },
    "device_id": { "type": "string" },
    "device_type": {
      "type": "string",
      "enum": ["ENVIRONMENTAL", "LIVESTOCK"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
