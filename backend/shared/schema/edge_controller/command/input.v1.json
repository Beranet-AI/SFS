{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeCommandInput",
  "type": "object",
  "required": [
    "command_id",
    "command_type",
    "edge_id",
    "issued_at",
    "payload"
  ],
  "properties": {
    "command_id": { "type": "string" },
    "command_type": {
      "type": "string",
      "enum": ["DISCOVER", "ON_OFF", "REBOOT"]
    },
    "edge_id": { "type": "string" },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
