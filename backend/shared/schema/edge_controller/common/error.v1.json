{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Error",
  "type": "object",
  "required": [
    "error_code",
    "message",
    "occurred_at"
  ],
  "properties": {
    "error_code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
