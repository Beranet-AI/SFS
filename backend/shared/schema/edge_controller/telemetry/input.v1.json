{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryInput",
  "type": "object",
  "required": [
    "edge_id",
    "device_id",
    "device_type",
    "timestamp",
    "metrics"
  ],
  "properties": {
    "edge_id": {
      "type": "string",
      "description": "Edge that collected telemetry"
    },
    "device_id": {
      "type": "string",
      "description": "Unique device or sensor identifier"
    },
    "device_type": {
      "type": "string",
      "enum": ["ENVIRONMENTAL", "LIVESTOCK", "PLANT"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "description": "Key-value telemetry metrics",
      "additionalProperties": {
        "type": "number"
      }
    },
    "meta": {
      "type": "object",
      "description": "Optional metadata (battery, signal, etc.)"
    }
  },
  "additionalProperties": false
}
